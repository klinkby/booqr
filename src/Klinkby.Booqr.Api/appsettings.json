{
  "AllowedHosts": "*.booqr.dk;www.booqr.dk;booqr.dk",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.DataProtection": "None"
    }
  },
  "Application": {
    "Jwt": {
      /* https://jwtsecret.com/generate */
      "Key": "fa15a2b38ad09128734698127364981276349827346fbbdba",
      "Issuer": "booqr",
      "Audience": "https://www.booqr.dk"
    },
    "Password": {
      "HmacKey": "Wzk4LDIyM23984756928374659238746592387465jUsNjBd"
    }
  },
  "Infrastructure": {
    "ConnectionString": "Host=localhost;Database=booqr;Username=postgres;Password=postgres",
    // "Host=postgres:5432;Database=postgres;Username=postgres;Password=...",
    "MailClientApiKey": "...:...",
    "MailClientAccount": "1.....smtp",
    "MailClientFromAddress": "no-reply@booqr.dk",
    "Tenancy": {
      "BaseDomain": "booqr.dk",
      "ReservedSubdomains": [ "www", "api" ]
    },
    "TenantDataSources": {
      // Host/database only — no Username/Password. The tenant role (t_<id>) and its
      // HMAC-derived password are supplied per tenant by TenantDataSourceFactory.
      "BaseConnectionString": "Host=localhost;Database=booqr",
      // HMAC master secret used to derive each tenant role's password. Override via
      // env/secret in every real deployment; never commit a production value.
      "MasterSecret": "changeme_tenant_master_secret",
      "MaxPoolSize": 3,
      "MaxCacheEntries": 64
    },
    "Registry": {
      // booqr_registry: SELECT-only on public.tenants; resolves host -> tenant.
      "ConnectionString": "Host=localhost;Database=booqr",
      "RegistryUsername": "booqr_registry",
      "RegistryPassword": "changeme_booqr_registry",
      "CacheTtl": "00:00:30",
      "CacheSize": 256
    },
    "Batch": {
      // booqr_batch: BYPASSRLS, cross-tenant. Used only by background/scheduled work
      // (reminder mail, refresh-token flushing, the ActivityBackgroundService consumer) via the
      // opt-in IBatchScope - never for request-handling scopes.
      "ConnectionString": "Host=localhost;Database=booqr",
      "BatchUsername": "booqr_batch",
      "BatchPassword": "changeme_booqr_batch"
    }
  },
  "Authentication": {
    "DefaultScheme": "Bearer",
    "Schemes": {
      "Bearer": {
        "ValidAudiences": [
          "https://www.booqr.dk"
        ],
        "ValidIssuer": "booqr"
      }
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:8080"
      }
    }
  }
}
