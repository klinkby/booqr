# =============================================================================
# Top-level .env — COMPOSE INTERPOLATION ONLY.
# =============================================================================
# This file is the ONLY source Docker Compose reads for `${...}` substitution in
# docker-compose.yml (image tags, healthcheck commands, and any value shared by
# more than one service). It is NOT injected into a container's environment.
#
# Per-container SECRETS live in the compartmented files under ./env/*.env, each
# mounted via `env_file:` into exactly the one service allowed to hold them, so a
# compromise of one container cannot read another compartment's credentials.
# Copy this to .env and copy every ./env/*.env.example to ./env/*.env, then fill
# in real values. Never commit real secrets.

# --- image tags (single place to bump versions; docker-compose.yml stays stable) ---
APP_TAG=409
API_TAG=178

# --- database identity (interpolated into connection strings + healthcheck) ---
# Not a secret. The password lives in ./env/postgres.env.
POSTGRES_DB=booqr
POSTGRES_USER=booqr

# --- tenancy host resolution (interpolated into api1 config) ---
TENANCY_BASE_DOMAIN=booqr.dk
