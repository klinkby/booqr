# api config
Kestrel__Certificates__Default__Password=cbf535fbbdba...fa15a2b38a
Application__Jwt__Key=fa15a2b38a...cbf535fbbdba
Application__Password__HmacKey=fa15a2b38a...cbf535fbbdba

# db config
POSTGRES_DB=booqr
POSTGRES_USER=booqr
POSTGRES_PASSWORD=...

# multi-tenancy: host resolution + role credentials (see redist/initdb/01-control-plane.sql for
# the role names and their placeholder passwords, which MUST be rotated via `admin --rotate` /
# ALTER ROLE before accepting production traffic).
TENANCY_BASE_DOMAIN=booqr.dk
# HMAC master secret used to derive every t_<id> tenant role's password (api1 + admin containers).
# Never commit a real value. Rotate via `docker compose run --rm admin admin --rotate` (reads
# TENANT_MASTER_SECRET as the current secret and TENANT_MASTER_SECRET_NEW as the replacement).
TENANT_MASTER_SECRET=changeme_tenant_master_secret
TENANT_MASTER_SECRET_NEW=changeme_tenant_master_secret_new
BOOQR_REGISTRY_PASSWORD=changeme_booqr_registry
BOOQR_BATCH_PASSWORD=changeme_booqr_batch

# admin container only (booqr_migrator: CREATEROLE, owns app/public objects — never given to api1)
BOOQR_MIGRATOR_PASSWORD=changeme_booqr_migrator
