# Backup settings — copy to restic.env (mode 600, owned by the service user). Sourced by bash.
# Keep RESTIC_PASSWORD in a password manager too: without it the repository cannot be decrypted.

# SFTP target, e.g. a Hetzner Storage Box sub-account (port 23, path relative to its chroot).
# Use a dedicated sub-account per host so one box can't delete another's backups.
BACKUP_SFTP_USER=u000000-sub1
BACKUP_SFTP_HOST=u000000.your-storagebox.de
BACKUP_SFTP_PORT=23
BACKUP_SFTP_PATH=booqr-restic

# Dedicated key + pinned host key (ssh-keyscan -p 23 <host> > known_hosts file, verify fingerprint)
BACKUP_SSH_KEY=$HOME/.ssh/id_ed25519_backup
BACKUP_SSH_KNOWN_HOSTS=$HOME/.ssh/known_hosts.backup

# Storage Boxes reset more than ~2 concurrent SFTP connections
RESTIC_SFTP_CONNECTIONS=2

# Repository encryption password (openssl rand -hex 32)
RESTIC_PASSWORD=changeme_restic_password

# restic snapshot --host tag
BACKUP_HOST_TAG=booqr

# Failure alerts (ntfy topic URL; pick an unguessable topic name)
NTFY_URL=https://ntfy.sh/changeme-topic
