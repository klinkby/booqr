# Shared compartment: EmailLabs credentials for the two services that send mail
# (api1 + worker). InfrastructureSettings marks these [Required] with
# ValidateOnStart(), so both services fail fast at startup if unset — they
# override the placeholder values baked into appsettings.json.
# Admin does NOT send mail and must not mount this file.
Infrastructure__MailClientApiKey=changeme_emaillabs_api_key
Infrastructure__MailClientAccount=changeme_emaillabs_account
Infrastructure__MailClientFromAddress=no-reply@booqr.dk
