# Compartment: api1 (tenant-facing web host).
# Holds: JWT signing key, TLS cert password, per-tenant HMAC master secret + the
# tenant HMAC key, and the SELECT-only registry credential.
# MUST NOT hold: booqr_migrator, booqr_batch, or the *_NEW rotation secret.

# TLS + JWT signing material (consumed by the app by config-key name).
Kestrel__Certificates__Default__Password=cbf535fbbdba...fa15a2b38a
Application__Jwt__Key=fa15a2b38a...cbf535fbbdba
Application__Password__HmacKey=fa15a2b38a...cbf535fbbdba

# HMAC master secret: derives every t_<id> tenant role password at request time.
Infrastructure__TenantDataSources__MasterSecret=changeme_tenant_master_secret

# Registry role (booqr_registry, SELECT-only on public.tenants): host -> tenant.
Infrastructure__Registry__RegistryPassword=changeme_booqr_registry
