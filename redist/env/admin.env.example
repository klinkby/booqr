# Compartment: admin (control-plane CLI: migrate/provision/deprovision/rotate).
# Holds the elevated booqr_migrator credential and BOTH tenant master secrets
# (current + rotation target). NOT the batch, registry, or JWT material.
# See redist/initdb/01-control-plane.sql for the role placeholder passwords,
# which MUST be rotated via `admin --rotate` / ALTER ROLE before production.
BOOQR_MIGRATOR_PASSWORD=changeme_booqr_migrator

# Rotate with: docker compose run --rm admin admin --rotate
#   BOOQR_TENANT_MASTER_SECRET     = current secret
#   BOOQR_TENANT_MASTER_SECRET_NEW = replacement secret
BOOQR_TENANT_MASTER_SECRET=changeme_tenant_master_secret
BOOQR_TENANT_MASTER_SECRET_NEW=changeme_tenant_master_secret_new
